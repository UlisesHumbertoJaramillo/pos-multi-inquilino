{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "asignacion-de-secreto",
            "patterns": [
              "/\\b[A-Z0-9_]*(PASSWORD|SECRET|TOKEN)[A-Z0-9_]*\\s*=\\s*(?<valor>[^\\s'\"`]{8,})/"
            ]
          }
        ]
      }
    }
  ]
}
