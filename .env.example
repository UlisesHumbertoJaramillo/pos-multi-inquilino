# Copia de referencia del archivo .env. Nunca pongas secretos reales en este archivo.
# `npm run db:setup` crea el .env y genera las contraseñas de los roles si están vacías.

# PostgreSQL local (instalado en Windows como servicio).
DB_HOST=localhost
DB_PORT=5432

# Rol de la aplicación: sin privilegios de dueño ni de superusuario.
DB_APP_PASSWORD=

# Rol dueño de las tablas: solo para migraciones y para el arnés de pruebas.
DB_OWNER_PASSWORD=

# Orígenes del frontend que pueden llamar a la API (CORS), separados por coma.
FRONTEND_ORIGIN=https://localhost:5173

# Base de datos de la aplicación (pos_dev en desarrollo).
DB_NAME=pos_dev

# Secreto que firma los tokens de acceso (JWT). db:setup lo genera si está vacío.
AUTH_TOKEN_SECRET=
# Clave maestra de la credencial fiscal (32 bytes en base64url). Obligatoria en producción.
FISCAL_MASTER_KEY=

# Adaptador de correo: "console" solo en desarrollo; el backend no arranca en producción con él.
EMAIL_ADAPTER=console
# Dirección del frontend, para los enlaces de los correos.
APP_PUBLIC_URL=https://localhost:5173
